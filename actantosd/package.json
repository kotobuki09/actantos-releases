{
  "name": "actantosd",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "ActantOS enforcement kernel prototype",
  "actantos": {
    "stage": "quiet-open-core",
    "releaseNotesFile": "docs/release-notes-v1.2.0.md"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "db:migrate": "tsx src/database-admin.ts migrate",
    "db:seed-demo": "tsx src/database-admin.ts seed-demo",
    "policy:regression": "node --experimental-strip-types --test src/policy-regression.test.ts",
    "policy:test": "tsx src/policy-test.ts",
    "test": "node --experimental-strip-types --test src/**/*.test.ts scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "demo": "tsx demo.ts",
    "demo:v2": "node --experimental-strip-types src/cli-demo-v2.ts",
    "bench:v2": "node --experimental-strip-types src/cli-bench-v2.ts",
    "evidence:verify": "node --experimental-strip-types src/cli-verify-evidence.ts",
    "smoke:fresh-install": "node scripts/fresh-install-smoke.mjs",
    "release:verify": "npm run typecheck && npm test && npm run build && npm run policy:regression && npm run bench && npm run security:state:check",
    "bench": "node --experimental-strip-types ../security-bench/src/bench.ts",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "audit:verify": "tsx src/cli-audit-verifier.ts",
    "preflight": "tsx src/cli-preflight.ts",
    "tetragon:emit": "node --experimental-strip-types src/cli-emit-tetragon.ts",
    "security:state": "node scripts/generate-security-fabric-state.mjs",
    "security:state:check": "node scripts/generate-security-fabric-state.mjs --check",
    "confidential:probe": "node scripts/confidential-computing-capability.mjs",
    "test:substrate": "node scripts/run-substrate-tests.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.6.1",
    "kysely": "^0.28.8",
    "openid-client": "^5.7.1",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "fast-check": "^4.10.2",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
